---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Faq from "../components/Faq.astro";
import { site, overflowClause } from "../data/site";
import portrait from "../assets/sherri-drum.webp";

const title = "Book a Woman Chauffeur, Not a Maybe | She Drives";
const description =
  "Every She Drives chauffeur is a woman, booked by name in advance. How we handle overflow, and who books us. Seal Beach, California TCP 46691-A.";

const crumbs = [
  { href: "/women-led-chauffeur-service/", label: "Women-led chauffeur service" },
];

const faq = [
  {
    q: "Can I request Sherri specifically?",
    a: "Yes. Most trips are Sherri. If you want her on a particular date, say so when you reserve and we will tell you straight away whether she is free.",
  },
  {
    q: "Do you charge more for a woman chauffeur?",
    a: "No. Nearly half of women say they refuse to pay extra for a woman driver because safety should not be a paid upgrade, and we agree. It is not a surcharge, it is who we are.",
  },
  {
    q: "What happens if you are already booked on my date?",
    a: "We tell you before anything is booked. If we cannot cover it ourselves we will offer a vetted partner operator, whose driver may not be a woman, and you decide whether that works for you.",
  },
  {
    q: "Can my company set up an account?",
    a: "Yes. Assistants booking on behalf of someone else is a normal part of the work. Tell us how you need to be invoiced and we will set it up.",
  },
  {
    q: "Is She Drives a rideshare service?",
    a: "No. There is no app and no on-demand matching. You reserve in advance, you know who is driving, and the arrangement does not change at the last minute.",
  },
];

const who = [
  {
    h: "Women traveling alone",
    p: "An early flight out of LAX or a late one back. The part of the trip you should not have to think about.",
  },
  {
    h: "Parents arranging a ride",
    p: "For a daughter heading to the airport, or for a parent who should not be driving at night.",
  },
  {
    h: "Companies booking travel",
    p: "For staff traveling alone, late, or into an unfamiliar city. A visible commitment rather than a policy line.",
  },
  {
    h: "Anyone who wants the same driver",
    p: "Weekly meetings, standing appointments, a recurring airport run. The arrangement that gets easier every time.",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path="/women-led-chauffeur-service/"
  crumbs={crumbs}
>
  <section class="section section--tight">
    <div class="wrap rail">
      <p class="rail__label">Women-led</p>
      <div>
        <h1 class="measure">Book a Woman Chauffeur by Name</h1>
        <p class="lead measure">
          Yes, you can book a woman chauffeur, and with She Drives you do not
          have to ask. Every chauffeur who drives for us is a woman, and you
          know which one is coming before the day arrives.
        </p>
      </div>
    </div>
  </section>

  <!-- The clause sits high on the page, not in the fine print. -->
  <section class="section">
    <div class="wrap rail">
      <p class="rail__label">Our promise</p>
      <div>
        <h2 class="measure">
          Including the part most companies leave out
        </h2>
        <div class="pledge">
          <p>{overflowClause}</p>
        </div>
        <p class="measure">
          We would rather tell you that up front than have you find out at the
          curb. A reservation only works if the thing you booked is the thing
          that shows up.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--blush">
    <div class="wrap rail">
      <p class="rail__label">The gap we fill</p>
      <div>
        <h2 class="measure">A preference is not a promise</h2>
        <p class="measure">
          Both major rideshare platforms now let women ask to be matched with a
          woman driver. It is a genuine improvement and worth using. It is also,
          by the platforms' own description, a preference that increases your
          chances rather than a guarantee, and on a busy night you may be
          matched with someone else.
        </p>
        <p class="measure">
          That gap is the whole reason She Drives exists. A reservation is not a
          preference. You pick the date, we confirm who is driving, and that is
          who arrives.
        </p>
        <p class="measure">
          The demand is not imagined either. In a 2026 survey of a thousand
          American women who use rideshare, close to six in ten said they had
          felt unsafe in one at least once, and roughly seven in ten said they
          use a fake phone call when riding alone at night.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap rail">
      <p class="rail__label">Who books us</p>
      <div class="grid grid--2">
        {
          who.map((w) => (
            <div class="card">
              <h3>{w.h}</h3>
              <p>{w.p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap rail">
      <p class="rail__label">Who is driving</p>
      <div class="founder">
        <div>
          <h2>Sherri drives most trips herself</h2>
          <p>
            She Drives is small on purpose. Sherri founded the company after a
            traumatic brain injury forced her to rebuild her health and her
            working life, and she built it around the thing she wanted most as a
            passenger: to feel safe, and not to have to think twice about it.
          </p>
          <p>
            The goal is to grow the bench of women chauffeurs this industry does
            not have, training them to the same standard. That part is still
            being built, and we would rather say so than imply a roster that is
            not there yet.
          </p>
          <p><a href="/about/">More about Sherri</a></p>
        </div>
        <div class="frame founder__portrait">
          <Image
            src={portrait}
            alt="Sherri Drum, founder of She Drives"
            widths={[420, 720]}
            sizes="(min-width: 56rem) 20rem, 92vw"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <Faq items={faq} label="Questions women ask before booking" />

  <section class="section section--ink">
    <div class="wrap rail">
      <p class="rail__label">Reserve</p>
      <div>
        <h2 class="measure">Reserve with us</h2>
        <p class="lead measure">
          Tell us the date and where you are going. We confirm who is driving
          before anything is booked.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/book/">Start a reservation</a>
          <a class="btn btn--ghost" href={site.smsHref}>Text {site.phone}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .founder {
    display: grid;
    gap: var(--s4);
    align-items: start;
  }
  @media (min-width: 56rem) {
    .founder {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: var(--s5);
    }
  }
  .founder h2 {
    margin-top: 0;
  }
  .founder__portrait {
    aspect-ratio: 4 / 5;
  }
</style>
